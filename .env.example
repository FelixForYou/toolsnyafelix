PORT=3000
NODE_ENV=production
# auto = secure cookie hanya saat HTTPS. Bisa set true/false jika perlu.
COOKIE_SECURE=auto
SESSION_SECRET=ganti-dengan-random-panjang-minimal-32-karakter
# Opsional. Kosong = semua host SSH boleh. Isi comma-separated untuk membatasi.
# Contoh: 1.2.3.4,node.domainkamu.com
ALLOWED_SSH_HOSTS=
